---
import { Image } from "astro:assets";
import { blends, comingNext } from "../data/site";
import { blendImages } from "../data/images";
import CtaButton from "./CtaButton.astro";
---

<section id="blends" class="bg-ivory">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p data-reveal class="eyebrow text-forest">The range</p>
        <h2 data-reveal style="--d: 80ms" class="display h-section mt-5 text-charcoal">
          Your family.<br />Your preferences.<br /><em>Better choices.</em>
        </h2>
      </div>
      <p data-reveal style="--d: 160ms" class="text-lg leading-relaxed text-pretty text-ink-soft lg:col-span-5 lg:pb-2">
        Start with the atta you know, or pick a blend for what your family needs
        right now. Every blend is at least half wheat, so your rotis still roll
        soft and puff up on the tawa.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3 lg:mt-16 lg:gap-7">
      {blends.map((b, i) => {
        const pic = blendImages[b.id as keyof typeof blendImages];
        return (
          <article data-reveal style={`--d: ${i * 120}ms`} class="group flex flex-col overflow-hidden rounded-[2rem] bg-white shadow-card ring-1 ring-black/[0.04]">
            <div class="reveal-img zoom relative aspect-[4/3]" style={`--d: ${i * 120 + 100}ms`}>
              <Image src={pic.src} alt={pic.alt} widths={[480, 760, 1000]} sizes="(min-width: 768px) 32vw, 100vw" class="h-full w-full object-cover" />
              <span class="absolute top-4 left-4 rounded-full bg-ivory/95 px-3.5 py-1.5 text-xs font-extrabold tracking-wide text-forest shadow-sm">{b.tag}</span>
            </div>

            <div class="flex flex-1 flex-col p-7">
              <h3 class="h-card text-charcoal">{b.name}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{b.body}</p>

              <ul class="mt-6 mb-7 space-y-2" aria-label={`${b.name} recipe`}>
                {b.recipe.map((g) => (
                  <li class="flex items-center gap-3 text-sm">
                    <span class="w-20 shrink-0 font-medium text-ink-soft">{g.grain}</span>
                    <span class="h-2 flex-1 overflow-hidden rounded-full bg-lime" aria-hidden="true">
                      <span class="block h-full rounded-full bg-forest" style={`width: ${g.pct}%`}></span>
                    </span>
                    <span class="w-10 shrink-0 text-right font-bold text-charcoal tabular-nums">{g.pct}%</span>
                  </li>
                ))}
              </ul>

              <div class="mt-auto">
                <CtaButton variant="ghost" size="md" label="Sample this blend" blend={b.id} class="w-full" />
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div data-reveal class="mt-8 grid gap-6 rounded-[2rem] bg-lime p-7 sm:p-9 lg:grid-cols-[14rem_1fr] lg:items-center lg:gap-10">
      <div>
        <p class="text-xs font-extrabold tracking-[0.16em] text-forest uppercase">Coming next</p>
        <p class="mt-2 font-display text-2xl leading-tight font-extrabold text-charcoal">More blends, shaped by you</p>
      </div>
      <ul class="grid gap-5 sm:grid-cols-3">
        {comingNext.map((c) => (
          <li>
            <p class="font-bold text-forest">{c.name}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">{c.body}</p>
          </li>
        ))}
      </ul>
    </div>

    <div data-reveal class="mt-12 flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-center sm:text-left">
      <CtaButton />
      <p class="text-sm font-semibold text-ink-soft">Tell us what you'd try. It shapes our first batches.</p>
    </div>
  </div>
</section>

---
import { Image } from "astro:assets";
import { img } from "../data/images";
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ivory">
  <div class="mx-auto max-w-7xl px-4 pt-16 pb-28 sm:px-6 md:pb-12 lg:px-8">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <Image src={img.logoFull} alt="Poshan. Better Choices. Better Life." widths={[220, 440]} sizes="200px" class="h-auto w-48" />
        <p class="mt-5 max-w-sm leading-relaxed text-ink-soft">
          Fresh, stone-ground atta milled to order in Melbourne. Poshan means
          nourishment, and it starts with the atta on your bench.
        </p>
        <a href={`mailto:${site.email}`} class="link-arrow mt-5 text-forest">{site.email}</a>
      </div>

      <div id="privacy" class="md:col-span-6 md:col-start-7">
        <h2 class="font-display text-xl font-extrabold text-charcoal">Privacy note</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          We use your name, email and suburb to contact you about Poshan's launch
          and to plan where we deliver first. We never sell or share your details,
          we never ask about medical conditions, and you can ask us to delete
          everything at any time by emailing us.
        </p>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-line pt-6 text-sm text-ink-soft/80 md:flex-row md:justify-between">
      <p>© {year} Poshan · Melbourne, Australia</p>
      <p>Blends shown are planned and may change before launch. Nutrition information will be published after lab testing.</p>
    </div>
  </div>
</footer>

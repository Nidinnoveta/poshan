---
import { cta } from "../data/site";
---

<div class="sticky-cta" data-sticky-cta inert>
  <button type="button" class="btn btn-primary btn-lg w-full" data-open-signup aria-haspopup="dialog">
    <span>{cta.sticky}</span>
    <svg class="arrow h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11M11 5.5 15.5 10 11 14.5" /></svg>
  </button>
</div>

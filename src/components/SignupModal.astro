---
import { Image } from "astro:assets";
import { goals, blends, cta, FORM_ENDPOINT, config } from "../data/site";
import { goalImages } from "../data/images";

const isDev = import.meta.env.DEV;
const blendChoices = [...blends.map((b) => ({ id: b.id, name: b.name })), { id: "unsure", name: "Not sure yet" }];
const successBody = config.trialConfirmed
  ? "We'll email {email} to arrange your free trial pack before we start milling."
  : "We'll email {email} to confirm your free sample, then help set up a delivery schedule that suits your family.";
---

<dialog
  id="signup"
  class="signup-dialog"
  aria-labelledby="signup-h1"
  data-endpoint={FORM_ENDPOINT}
  data-dev={isDev ? "true" : "false"}
  data-success-body={successBody}
>
  <div class="signup-scrim" data-close-signup></div>

  <div class="signup-panel" data-panel>
    <div class="signup-grabber" aria-hidden="true"></div>

    <div class="flex items-center justify-between gap-4">
      <p class="text-sm font-bold text-forest" data-step-label aria-live="polite">Step 1 of 2</p>
      <button
        type="button"
        data-close-signup
        class="grid h-10 w-10 place-items-center rounded-full bg-lime text-forest transition-colors hover:bg-lime-200 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-forest"
        aria-label="Close"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" /></svg>
      </button>
    </div>
    <div class="progress mt-3" role="progressbar" aria-label="Sign-up progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
      <span data-progress style="width: 50%"></span>
    </div>

    <form id="signup-form" class="mt-6" novalidate>
      <!-- Step 1: one visual question -->
      <section data-step="1">
        <h2 id="signup-h1" tabindex="-1" class="display font-display text-[2rem] leading-[1.05] font-extrabold text-charcoal outline-none sm:text-[2.35rem]">
          What matters <em>most to&nbsp;you?</em>
        </h2>
        <p class="mt-2 text-ink-soft">Pick one. It helps us match you to the right blend.</p>

        <div class="mt-5 grid gap-2.5 sm:grid-cols-2" role="group" aria-labelledby="signup-h1">
          {goals.map((g) => {
            const pic = g.id !== "other" ? goalImages[g.id] : null;
            return (
              <button type="button" class={`goal-select ${g.id === "other" ? "sm:col-span-2" : ""}`} data-goal-tile={g.id} data-label={g.label} aria-pressed="false">
                {pic ? (
                  <span class="h-14 w-14 shrink-0 overflow-hidden rounded-xl">
                    <Image src={pic.src} alt="" widths={[112]} sizes="56px" class="h-full w-full object-cover" />
                  </span>
                ) : (
                  <span class="grid h-14 w-14 shrink-0 place-items-center rounded-xl bg-lime text-forest" aria-hidden="true">
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
                  </span>
                )}
                <span class="min-w-0">
                  <span class="block font-bold text-charcoal">{g.label}</span>
                  <span class="block text-sm leading-snug text-ink-soft">{g.hint}</span>
                </span>
                <span class="tick" aria-hidden="true">
                  <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5 8 14l8-8" /></svg>
                </span>
              </button>
            );
          })}
        </div>

        <div data-other-wrap hidden class="mt-4">
          <label for="su-other" class="text-sm font-bold text-charcoal">What would you like from your atta? <span class="font-medium text-ink-soft">(optional)</span></label>
          <input id="su-other" name="goal_other" type="text" maxlength="140" class="field" placeholder="e.g. something gluten-friendly for my mum" />
        </div>

        <div class="mt-6 flex justify-end">
          <button type="button" class="btn btn-primary btn-md" data-next disabled>
            <span>Continue</span>
            <svg class="arrow h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11M11 5.5 15.5 10 11 14.5" /></svg>
          </button>
        </div>
      </section>

      <!-- Step 2: contact details -->
      <section data-step="2" hidden>
        <h2 id="signup-h2" tabindex="-1" class="display font-display text-[2rem] leading-[1.05] font-extrabold text-charcoal outline-none sm:text-[2.35rem]">
          Almost there.<br /><em>Where should we send your sample?</em>
        </h2>
        <p data-goal-line class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-soft">
          You picked <span class="rounded-full bg-lime px-3 py-1 text-sm font-bold text-forest" data-goal-summary></span>
          <button type="button" data-back class="text-sm font-bold text-forest underline underline-offset-4 hover:no-underline">Change</button>
        </p>

        <fieldset class="mt-5">
          <legend class="text-sm font-bold text-charcoal">Blend you'd like to try</legend>
          <div class="mt-2 grid grid-cols-2 gap-2">
            {blendChoices.map((b) => (
              <label class="cursor-pointer">
                <input type="radio" name="blend" value={b.name} data-blend-option={b.id} checked={b.id === "unsure"} class="peer sr-only" />
                <span class="flex h-full items-center rounded-xl border-[1.5px] border-line bg-white px-3.5 py-2.5 text-sm leading-snug font-bold text-charcoal transition-colors peer-checked:border-forest peer-checked:bg-lime peer-checked:text-forest peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-forest hover:border-forest/50">{b.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-5 space-y-4">
          <div>
            <label for="su-name" class="text-sm font-bold text-charcoal">First name</label>
            <input id="su-name" name="first_name" type="text" autocomplete="given-name" required maxlength="60" class="field" aria-describedby="err-name" />
            <p id="err-name" class="mt-1.5 text-sm font-semibold text-terracotta-700" hidden>Please tell us your first name.</p>
          </div>
          <div>
            <label for="su-email" class="text-sm font-bold text-charcoal">Email</label>
            <input id="su-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="120" class="field" aria-describedby="err-email" />
            <p id="err-email" class="mt-1.5 text-sm font-semibold text-terracotta-700" hidden>Please enter a valid email address.</p>
          </div>
          <div>
            <label for="su-suburb" class="text-sm font-bold text-charcoal">Suburb</label>
            <input id="su-suburb" name="suburb" type="text" autocomplete="address-level2" required maxlength="60" class="field" placeholder="e.g. Tarneit" aria-describedby="err-suburb" />
            <p id="err-suburb" class="mt-1.5 text-sm font-semibold text-terracotta-700" hidden>Please tell us your suburb.</p>
          </div>


          <div>
            <button type="button" data-add-mobile class="text-sm font-bold text-forest underline underline-offset-4 hover:no-underline">
              + Add a mobile for WhatsApp updates <span class="font-medium text-ink-soft">(optional)</span>
            </button>
            <div data-mobile-field hidden>
              <label for="su-mobile" class="text-sm font-bold text-charcoal">Mobile <span class="font-medium text-ink-soft">(optional)</span></label>
              <input id="su-mobile" name="mobile" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" class="field" />
            </div>
          </div>
        </div>

        <input type="hidden" name="goal" data-goal-input />
        <input type="hidden" name="source" data-src-input />
        <div class="hidden" aria-hidden="true">
          <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>

        <p data-form-error role="alert" class="mt-5 rounded-xl bg-[#fdece4] px-4 py-3 text-sm font-semibold text-terracotta-700" hidden></p>

        <p class="mt-6 flex items-start gap-2.5 rounded-xl bg-lime px-4 py-3 text-sm leading-snug font-semibold text-forest">
          <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h14v9H3zM2 5h16v3H2zM10 5v12M10 5c-1.5-3-5-3-5-.5S8.5 5 10 5c1.5 0 5 0 5-.5S11.5 2 10 5" /></svg>
          {cta.sampleNote}
        </p>

        <button type="submit" class="btn btn-primary btn-lg mt-4 w-full" data-submit>
          <span class="spinner" data-spinner hidden></span>
          <span data-submit-label>{cta.submit}</span>
        </button>
        <p class="mt-4 text-center text-xs leading-relaxed text-ink-soft">
          No payment. We'll only email you about Poshan, and you can unsubscribe any time.
          <a href="#privacy" data-close-signup class="font-bold underline underline-offset-2">Privacy note</a>
        </p>
      </section>

      <!-- Done -->
      <section data-step="done" hidden class="py-4 text-center">
        <svg class="success-mark mx-auto h-20 w-20" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <circle cx="32" cy="32" r="25" stroke="#8ccb27" stroke-width="4" stroke-linecap="round" />
          <path d="M21 33l7.5 7.5L44 25" stroke="#164b23" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h2 id="signup-h3" tabindex="-1" class="display mt-6 font-display text-[2rem] leading-[1.05] font-extrabold text-charcoal outline-none sm:text-[2.35rem]" data-success-title>
          Your sample request is in.
        </h2>
        <p class="mx-auto mt-4 max-w-sm leading-relaxed text-ink-soft" data-success-text></p>

        <div class="mx-auto mt-6 max-w-sm rounded-2xl border border-line bg-white p-5 text-left">
          <p class="text-xs font-extrabold tracking-[0.14em] text-forest uppercase">Your details</p>
          <dl class="mt-3 grid grid-cols-[6.5rem_1fr] gap-x-3 gap-y-2 text-sm" data-summary></dl>
        </div>

        <p data-test-notice hidden class="mx-auto mt-4 max-w-sm rounded-xl bg-[#fdece4] px-4 py-3 text-left text-sm font-semibold text-terracotta-700">
          Test mode: this sign-up was not saved anywhere. Set PUBLIC_FORM_ENDPOINT to start collecting sign-ups.
        </p>

        <div class="mx-auto mt-8 max-w-sm rounded-2xl bg-lime p-5">
          <p class="font-bold text-forest">Know another family who makes rotis every day?</p>
          <div class="mt-4 flex flex-col gap-2.5 sm:flex-row sm:justify-center">
            <a data-whatsapp target="_blank" rel="noopener" class="btn btn-primary btn-md">Share on WhatsApp</a>
            <button type="button" data-share class="btn btn-ghost btn-md">Copy link</button>
          </div>
        </div>

        <div class="mt-7 flex flex-col items-center gap-3">
          <button type="button" data-close-signup class="btn btn-ghost btn-md">Back to the page</button>
          <button type="button" data-reset class="text-sm font-bold text-ink-soft underline underline-offset-4 hover:text-forest">Sign up someone else</button>
        </div>
      </section>
    </form>
  </div>
</dialog>

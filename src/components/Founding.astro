---
import { Image } from "astro:assets";
import { img } from "../data/images";
import { founding } from "../data/site";
import CtaButton from "./CtaButton.astro";

const points = [
  "Melbourne households first, starting in the west",
  "A free sample for your family to try",
  "Your feedback shapes the range we launch",
];
---

<section id="founding" class="on-dark relative overflow-hidden bg-forest text-ivory" style="--em: var(--color-leaf)">
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-56 -left-40 h-[36rem] w-[36rem] rounded-full bg-leaf/20 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-12 lg:gap-16 lg:px-8 lg:py-32">
    <div class="relative lg:col-span-6">
      <figure class="reveal-img aspect-[4/5] rounded-[2rem] shadow-2xl sm:aspect-[5/4] lg:aspect-[4/5] lg:rounded-[2.75rem]">
        <Image
          src={img.coupleKitchen}
          alt="A young couple laughing together as they mix dough in their kitchen"
          widths={[560, 900, 1300]}
          sizes="(min-width: 1024px) 44vw, 100vw"
          class="h-full w-full object-cover object-[50%_35%]"
        />
      </figure>
      <div data-reveal style="--d: 400ms" class="absolute -top-4 right-4 rotate-3 rounded-2xl bg-leaf px-5 py-3 text-forest-900 shadow-xl lg:-right-6">
        <p class="text-[0.68rem] font-extrabold tracking-[0.16em] uppercase">Founding families</p>
        <p class="font-display text-xl font-extrabold">{founding.badge}</p>
      </div>
    </div>

    <div class="lg:col-span-6">
      <p data-reveal class="eyebrow text-leaf">Founding families</p>
      <h2 data-reveal style="--d: 80ms" class="display h-section mt-5 text-balance text-ivory">
        Be among the first to bring <em>Poshan</em> home.
      </h2>
      <p data-reveal style="--d: 160ms" class="mt-7 max-w-xl text-lg leading-relaxed text-pretty text-ivory/80">
        {founding.body}
      </p>

      <ul class="mt-8 space-y-3.5">
        {points.map((p, i) => (
          <li data-reveal style={`--d: ${220 + i * 80}ms`} class="flex items-start gap-3.5 text-ivory/90">
            <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-leaf text-forest-900">
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 8 14l8-8" /></svg>
            </span>
            <span class="font-medium">{p}</span>
          </li>
        ))}
      </ul>

      <div data-reveal style="--d: 480ms" class="mt-10">
        <CtaButton />
      </div>
    </div>
  </div>
</section>

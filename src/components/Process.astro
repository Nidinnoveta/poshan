---
import { Image } from "astro:assets";
import { img, processImages } from "../data/images";
import { journey, cta } from "../data/site";
import CtaButton from "./CtaButton.astro";

const tick = `<svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 8 14l8-8" /></svg>`;
---

<section id="how" class="bg-lime">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <!-- Heading -->
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p data-reveal class="eyebrow text-forest">From grain to your door</p>
        <h2 data-reveal style="--d: 80ms" class="display h-section mt-5 text-balance text-charcoal">
          Milled clean. <em>At your door before you run out.</em>
        </h2>
      </div>
      <p data-reveal style="--d: 160ms" class="text-lg leading-relaxed text-pretty text-ink-soft lg:col-span-5 lg:pb-2">
        We handle every step ourselves, in small batches, with the care you'd
        expect in your own kitchen. Then we bring it to you on a schedule that
        suits your family.
      </p>
    </div>

    <!-- How it's made: four steps -->
    <ol class="mt-14 grid gap-x-8 gap-y-12 md:grid-cols-2 lg:mt-16 lg:gap-x-10 lg:gap-y-14">
      {journey.steps.map((step, i) => {
        const pic = processImages[i];
        return (
          <li data-reveal style={`--d: ${(i % 2) * 110}ms`} class="flex flex-col">
            <div class="reveal-img zoom relative aspect-[4/3] rounded-[1.75rem] shadow-card lg:rounded-[2.25rem]" style={`--d: ${(i % 2) * 110 + 80}ms`}>
              <Image src={pic.src} alt={pic.alt} widths={[480, 760, 1100, 1448]} sizes="(min-width: 1280px) 38rem, (min-width: 768px) 46vw, 100vw" class="h-full w-full object-cover" style={`object-position: ${pic.pos}`} />
              <span class="absolute top-5 left-5 grid h-12 w-12 place-items-center rounded-full bg-ivory text-sm font-extrabold text-forest shadow-md">0{i + 1}</span>
            </div>
            <h3 class="h-card mt-6 text-charcoal">{step.title}</h3>
            <p class="mt-2.5 max-w-lg text-lg leading-relaxed text-ink-soft">{step.body}</p>
          </li>
        );
      })}
    </ol>

    <!-- Hygiene commitments -->
    <ul data-reveal class="mt-12 flex flex-wrap gap-2.5" aria-label="Our hygiene standards">
      {journey.hygiene.map((h) => (
        <li class="inline-flex items-center gap-2 rounded-full bg-ivory px-4 py-2.5 text-sm font-bold text-forest ring-1 ring-forest/10">
          <span class="grid h-5 w-5 place-items-center rounded-full bg-forest text-leaf" set:html={tick} />
          {h}
        </li>
      ))}
    </ul>

    <!-- Delivered on your schedule -->
    <div data-reveal class="on-dark mt-16 grid overflow-hidden rounded-[2.25rem] bg-forest text-ivory shadow-hero lg:mt-20 lg:grid-cols-12 lg:rounded-[2.75rem]" style="--em: var(--color-leaf)">
      <div class="reveal-img relative min-h-[20rem] sm:min-h-[26rem] lg:col-span-5 lg:min-h-full">
        <Image
          src={img.parathaKitchen}
          alt="A smiling woman cooks a paratha on a tawa in her bright kitchen, with a steel plate of fresh rotis beside her"
          widths={[560, 900, 1200, 1490]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover object-[45%_58%]"
        />
      </div>

      <div class="p-8 sm:p-12 lg:col-span-7 lg:p-14">
        <p class="eyebrow text-leaf">How it works for you</p>
        <h3 class="display h-section mt-5 text-balance text-ivory">Never run out of <em>fresh atta.</em></h3>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ivory/80">
          Register your interest and we'll reach out to share a sample and set up
          a delivery schedule that suits your family. Each pack is milled the week
          it's due and brought to your door.
        </p>

        <ol class="mt-9 space-y-6">
          {journey.delivery.map((d, i) => (
            <li class="grid grid-cols-[auto_1fr] gap-x-5">
              <span class="grid h-11 w-11 place-items-center rounded-full bg-leaf text-sm font-extrabold text-forest-900">0{i + 1}</span>
              <div>
                <p class="font-display text-xl font-extrabold text-ivory">{d.title}</p>
                <p class="mt-1 leading-relaxed text-ivory/75">{d.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="mt-10 flex flex-col items-start gap-3">
          <CtaButton label={cta.primary} />
          <p class="text-sm text-ivory/65">Registering doesn't commit you to anything.</p>
        </div>
      </div>
    </div>
  </div>
</section>

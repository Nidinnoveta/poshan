---
import { Image } from "astro:assets";
import { img } from "../data/images";
import { cta } from "../data/site";
import CtaButton from "./CtaButton.astro";

---

<section id="top" class="relative overflow-hidden">
  <!-- soft colour field behind the composition -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 right-[-10%] h-[42rem] w-[42rem] rounded-full bg-lime blur-3xl opacity-80"></div>
    <div class="absolute bottom-[-12rem] left-[-12rem] h-[30rem] w-[30rem] rounded-full bg-[#fbe8d8] blur-3xl opacity-70"></div>
  </div>

  <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 pt-5 pb-16 sm:px-6 sm:pt-8 lg:grid-cols-12 lg:gap-6 lg:px-8 lg:pt-14 lg:pb-28">
    <!-- Visual composition -->
    <div class="relative lg:order-2 lg:col-span-5 lg:col-start-8">
      <div class="reveal-img relative aspect-[4/3] rounded-[1.75rem] shadow-hero lg:aspect-[4/5] lg:rounded-[2.75rem]">
        <Image
          src={img.heroAttaBag}
          alt="An open paper bag of fresh atta beside a plate of soft, freshly made rotis"
          widths={[640, 960, 1254]}
          sizes="(min-width: 1024px) 46vw, 100vw"
          class="h-full w-full object-cover object-[35%_50%]"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div
        class="reveal-img absolute -bottom-10 -left-10 hidden aspect-[3/4] w-[36%] rounded-[1.6rem] border-[7px] border-ivory shadow-2xl lg:block"
        style="--d: 300ms"
      >
        <Image
          src={img.tavaRoti}
          alt="A hand turning a roti on a hot tawa"
          widths={[320, 520]}
          sizes="16vw"
          class="h-full w-full object-cover object-[50%_35%]"
          loading="eager"
        />
      </div>

    </div>

    <!-- Copy -->
    <div class="lg:order-1 lg:col-span-7 lg:pr-10">
      <p data-reveal class="eyebrow text-forest">Stone-ground in Melbourne</p>

      <h1 data-reveal style="--d: 90ms" class="display h-hero mt-5 text-balance text-charcoal">
        Fresh chakki atta,<br />
        <em>just like back home.</em>
      </h1>

      <p data-reveal style="--d: 180ms" class="mt-7 max-w-xl text-lg leading-relaxed text-pretty text-ink-soft sm:text-xl">
        Remember the atta from the chakki back home? Freshly ground, soft rotis,
        that lovely smell when you open the bag. Poshan brings it to Melbourne:
        whole wheat stone-ground fresh for your family and delivered to your door.
      </p>

      <div data-reveal style="--d: 270ms" class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <span data-hero-cta><CtaButton /></span>
        <a href="#concern" class="link-arrow text-forest">
          Why your atta matters
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4v12M5.5 11.5 10 16l4.5-4.5" /></svg>
        </a>
      </div>

      <p data-reveal style="--d: 360ms" class="mt-7 flex items-center gap-2 text-sm font-semibold text-ink-soft">
        <span class="grid h-5 w-5 place-items-center rounded-full bg-leaf text-forest-900">
          <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 8 14l8-8" /></svg>
        </span>
        {cta.reassure}
      </p>
    </div>
  </div>
</section>

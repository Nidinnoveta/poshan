---
import { Image } from "astro:assets";
import { img } from "../data/images";

const questions = [
  {
    q: "When was it actually milled?",
    a: "Most packs show a best-before date, not the day the grain was ground. Wholemeal flour carries natural oils from the wheat germ, and they slowly turn stale after milling.",
  },
  {
    q: "What's really in the “multigrain”?",
    a: "There's no set amount of other grains a multigrain pack has to contain. Plenty are mostly wheat, with a little of everything else.",
  },
  {
    q: "How far has it travelled?",
    a: "Paddock, mill, port, warehouse, shelf, pantry. The longer the journey, the more there is that you simply can't see.",
  },
];
---

<section id="concern" class="bg-lime">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <!-- Row 1: the question, with the family -->
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <p data-reveal class="eyebrow text-terracotta-700">A question worth asking</p>
        <h2 data-reveal style="--d: 80ms" class="display h-section mt-5 text-balance text-charcoal">
          You care about what your family eats.
          <em>But have you thought about your atta?</em>
        </h2>
        <p data-reveal style="--d: 160ms" class="mt-7 text-lg leading-relaxed text-pretty text-ink-soft">
          You check the vegetables. You read the label on the kids' snacks. But
          the atta behind almost every meal usually comes home in a big bag and
          sits in the pantry for months. And the bag doesn't say much.
        </p>
        <p data-reveal style="--d: 220ms" class="mt-4 text-lg leading-relaxed font-semibold text-forest">
          No judgement. It's simply how atta has always been sold.
        </p>
      </div>

      <figure class="reveal-img relative aspect-[4/3] rounded-[2rem] shadow-card lg:col-span-7 lg:aspect-[3/2] lg:rounded-[2.75rem]">
        <Image
          src={img.familyCheckingPack}
          alt="A mother reads the back of an atta pack while her husband and two children look on, thinking"
          widths={[640, 960, 1400]}
          sizes="(min-width: 1024px) 56vw, 100vw"
          class="h-full w-full object-cover"
        />
      </figure>
    </div>

    <!-- Row 2: three questions, with the man weighing it up -->
    <div class="mt-16 grid items-stretch gap-10 lg:mt-24 lg:grid-cols-12 lg:gap-14">
      <figure class="reveal-img relative aspect-[4/3] rounded-[2rem] shadow-card lg:order-2 lg:col-span-5 lg:aspect-auto lg:rounded-[2.75rem]">
        <Image
          src={img.manCheckingAtta}
          alt="A man rubs atta between his fingers at the kitchen table, wondering what's in it"
          widths={[560, 900, 1300]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="h-full w-full object-cover object-[40%_50%]"
        />
      </figure>

      <ol class="flex flex-col justify-center divide-y divide-forest/15 lg:order-1 lg:col-span-7">
        {questions.map((item, i) => (
          <li data-reveal style={`--d: ${i * 110}ms`} class="grid grid-cols-[auto_1fr] gap-x-6 py-7 first:pt-0 last:pb-0">
            <span class="font-display text-5xl leading-none font-extrabold text-forest/20 sm:text-6xl">0{i + 1}</span>
            <div>
              <h3 class="font-display text-2xl leading-tight font-extrabold text-charcoal sm:text-[1.75rem]">{item.q}</h3>
              <p class="mt-2.5 max-w-xl leading-relaxed text-ink-soft">{item.a}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

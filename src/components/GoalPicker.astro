---
import { Image } from "astro:assets";
import { goals } from "../data/site";
import { goalImages } from "../data/images";
---

<section id="join" class="bg-ivory">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="mx-auto max-w-3xl text-center">
      <p data-reveal class="eyebrow justify-center text-forest">Your free sample in 30 seconds</p>
      <h2 data-reveal style="--d: 80ms" class="display h-section mt-5 text-balance text-charcoal">
        What matters most <em>to your family?</em>
      </h2>
      <p data-reveal style="--d: 160ms" class="mt-6 text-lg leading-relaxed text-ink-soft">
        Pick one to get started. Then it's just your first name, email and suburb.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-5">
      {goals.map((g, i) => {
        const pic = g.id !== "other" ? goalImages[g.id] : null;
        return pic ? (
          <button
            type="button"
            data-open-signup
            data-goal={g.id}
            aria-haspopup="dialog"
            data-reveal
            style={`--d: ${i * 80}ms`}
            class="group relative aspect-[4/5] overflow-hidden rounded-[1.75rem] text-left shadow-card transition-transform duration-300 hover:-translate-y-1 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-forest"
          >
            <Image src={pic.src} alt="" widths={[320, 560]} sizes="(min-width: 1024px) 19vw, 46vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
            <span class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/25 to-transparent"></span>
            <span class="absolute inset-x-0 bottom-0 p-5">
              <span class="block font-display text-2xl leading-tight font-extrabold text-ivory">{g.label}</span>
              <span class="mt-1 block text-sm leading-snug text-ivory/80">{g.hint}</span>
            </span>
            <span class="absolute top-4 right-4 grid h-9 w-9 place-items-center rounded-full bg-ivory/90 text-forest transition-colors group-hover:bg-leaf" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11M11 5.5 15.5 10 11 14.5" /></svg>
            </span>
          </button>
        ) : (
          <button
            type="button"
            data-open-signup
            data-goal={g.id}
            aria-haspopup="dialog"
            data-reveal
            style={`--d: ${i * 80}ms`}
            class="group col-span-2 flex flex-col justify-between rounded-[1.75rem] border-2 border-dashed border-forest/25 bg-lime p-6 text-left transition-colors hover:border-forest lg:col-span-1 lg:aspect-[4/5]"
          >
            <span class="grid h-12 w-12 place-items-center rounded-full bg-forest text-leaf" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
            </span>
            <span class="mt-6 block">
              <span class="block font-display text-2xl leading-tight font-extrabold text-charcoal">{g.label}</span>
              <span class="mt-1 block text-sm text-ink-soft">{g.hint}</span>
            </span>
          </button>
        );
      })}
    </div>
  </div>
</section>

---
import { Image } from "astro:assets";
import { img } from "../data/images";
import CtaButton from "./CtaButton.astro";
import { cta } from "../data/site";
---

<section id="difference" class="bg-ivory">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p data-reveal class="eyebrow text-forest">The Poshan difference</p>
        <h2 data-reveal style="--d: 80ms" class="display h-section mt-5 text-balance text-charcoal">
          Freshly milled.<br /><em>Thoughtfully made.</em>
        </h2>
      </div>
      <p data-reveal style="--d: 160ms" class="text-lg leading-relaxed text-pretty text-ink-soft lg:col-span-5 lg:pb-2">
        We started Poshan because we wanted to know exactly what was in the rotis
        we serve our own families. So we built the atta we wanted to buy.
      </p>
    </div>

    <!-- Bento -->
    <div class="mt-14 grid gap-4 sm:gap-5 lg:mt-16 lg:h-[50rem] lg:grid-cols-3 lg:grid-rows-2">
      <figure class="reveal-img zoom relative aspect-[4/5] rounded-[2rem] sm:aspect-[16/10] lg:row-span-2 lg:aspect-auto lg:rounded-[2.5rem]">
        <Image src={img.handsFlour} alt="Hands working through freshly milled flour in a glass bowl" widths={[560, 900, 1400]} sizes="(min-width: 1024px) 32vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[68%_55%]" />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/25 to-transparent"></div>
        <figcaption class="absolute inset-x-0 bottom-0 p-7 text-ivory lg:p-9">
          <p class="text-xs font-extrabold tracking-[0.16em] text-leaf uppercase">01</p>
          <h3 class="h-card mt-2">Milled to order</h3>
          <p class="mt-2 max-w-sm leading-relaxed text-ivory/85">We stone-grind in small batches after you order, in Melbourne's west. The milled-on date is printed on every pack.</p>
        </figcaption>
      </figure>

      <figure class="reveal-img zoom relative aspect-[16/10] rounded-[2rem] lg:aspect-auto lg:rounded-[2.5rem]" style="--d: 120ms">
        <Image src={img.wheatField} alt="A field of golden wheat ready for harvest" widths={[560, 900, 1400]} sizes="(min-width: 1024px) 32vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-900/85 via-forest-900/10 to-transparent"></div>
        <figcaption class="absolute inset-x-0 bottom-0 p-7 text-ivory">
          <p class="text-xs font-extrabold tracking-[0.16em] text-leaf uppercase">02</p>
          <h3 class="h-card mt-2">Australian-grown grain</h3>
          <p class="mt-2 leading-relaxed text-ivory/85">Wheat, chana, oats and barley from Victorian farms.</p>
        </figcaption>
      </figure>

      <div data-reveal style="--d: 200ms" class="flex flex-col justify-between rounded-[2rem] bg-lime p-7 lg:rounded-[2.5rem] lg:p-9">
        <div>
          <p class="text-xs font-extrabold tracking-[0.16em] text-forest uppercase">03</p>
          <h3 class="h-card mt-2 text-charcoal">Every grain on the front</h3>
          <p class="mt-2 leading-relaxed text-ink-soft">If it's in the blend, you'll see its percentage. Nothing vague, nothing hidden.</p>
        </div>
        <dl class="mt-5 grid grid-cols-3 gap-x-3 gap-y-3">
          {[["70", "Wheat"], ["10", "Chana"], ["8", "Oats"], ["7", "Jowar"], ["3", "Soy"], ["2", "Flax"]].map(([n, g]) => (
            <div>
              <dt class="sr-only">{g}</dt>
              <dd class="font-display text-[2.1rem] leading-none font-extrabold text-forest">{n}<span class="text-xl">%</span></dd>
              <dd class="mt-1 text-xs font-bold tracking-wide text-ink-soft uppercase" aria-hidden="true">{g}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="reveal-img zoom relative aspect-[16/10] rounded-[2rem] lg:col-span-2 lg:aspect-auto lg:rounded-[2.5rem]" style="--d: 160ms">
        <Image src={img.qualityAtta} alt="A bowl of fresh atta beside whole grains, a bowl of dal and a golden roti" widths={[640, 1000, 1254]} sizes="(min-width: 1024px) 64vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_60%]" />
        <div class="absolute inset-0 bg-gradient-to-r from-forest-900/80 via-forest-900/20 to-transparent"></div>
        <figcaption class="absolute inset-y-0 left-0 flex max-w-md flex-col justify-end p-7 text-ivory lg:p-9">
          <p class="text-xs font-extrabold tracking-[0.16em] text-leaf uppercase">04</p>
          <h3 class="h-card mt-2">Nothing added</h3>
          <p class="mt-2 leading-relaxed text-ivory/85">No preservatives, no improvers, no added fats. Just whole grain, ground fresh.</p>
        </figcaption>
      </figure>
    </div>

    <div data-reveal class="mt-12 flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-center sm:text-left">
      <CtaButton />
      <p class="text-sm font-semibold text-ink-soft">{cta.reassure}</p>
    </div>
  </div>
</section>
